# GEMINI_API_KEY: Required for Gemini AI API calls when Gemini is selected.
# Configure as a server-side secret in the deployment environment (e.g. Render).
GEMINI_API_KEY=""
# Optional Gemini model override; defaults to gemini-3.8-flash.
GEMINI_MODEL="gemini-3.8-flash"

# Optional OpenAI provider (inactive unless explicitly selected in Security & Privacy).
# Keep server-side only; never use a VITE_ prefix.
OPENAI_API_KEY=""
OPENAI_MODEL=""

# APP_URL: The exact HTTPS origin where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# Supabase — required only after a project is provisioned.
# Keep the service role and encryption key server-side; NEVER use a VITE_ prefix.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Exact email address of the one owner account provisioned in Supabase Auth.
SUPABASE_OWNER_EMAIL=""
# Set true only after the Supabase project, owner login and migrations pass staging checks.
# SUPABASE_AUTH_REQUIRED="true"
APP_ENCRYPTION_KEY=""
APP_ENCRYPTION_KEY_VERSION="v1"

# WebAuthn — required in production; exact comma-separated origins, no paths.
# Example: WEBAUTHN_RP_ID="example.com"
# Example: WEBAUTHN_ALLOWED_ORIGINS="https://app.example.com"
WEBAUTHN_RP_ID=""
WEBAUTHN_ALLOWED_ORIGINS=""

# Local-only convenience for synthetic-data testing.
# The server ignores this in production. Never use preview mode with real/private data.
ENABLE_PREVIEW_AUTH="true"
