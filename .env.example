# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""
# Optional model override; default is the current Flash model used by Jarvis.
GEMINI_MODEL="gemini-3.8-flash"

# Optional OpenAI provider. Select it in Security & Privacy only after configuring both values.
# Keep this key server-side; never use a VITE_ prefix.
OPENAI_API_KEY=""
OPENAI_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# Supabase — required only after a project is provisioned.
# Keep the service role and encryption key server-side; NEVER use a VITE_ prefix.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
APP_ENCRYPTION_KEY=""
APP_ENCRYPTION_KEY_VERSION="v1"

# WebAuthn — required in production; exact comma-separated origins, no paths.
# Example: WEBAUTHN_RP_ID="example.com"
# Example: WEBAUTHN_ALLOWED_ORIGINS="https://app.example.com"
WEBAUTHN_RP_ID=""
WEBAUTHN_ALLOWED_ORIGINS=""

# Local-only convenience for synthetic-data testing.
# The server ignores this in production. Never use preview mode with real/private data.
ENABLE_PREVIEW_AUTH="true"
